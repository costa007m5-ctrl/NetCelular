{
  "expo": {
    "name": "NETPLAY",
    "slug": "net-pla",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.netplay.app"
    },
    "android": {
      "package": "com.netplay.app"
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "bundler": "metro",
      "name": "NETPLAY",
      "shortName": "NETPLAY",
      "description": "Descubra e assista aos melhores filmes e séries em streaming. Catálogo premium atualizado com os lançamentos mais recentes do cinema e TV.",
      "themeColor": "#000000",
      "backgroundColor": "#000000",
      "lang": "pt-BR"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24,
            "buildToolsVersion": "35.0.0",
            "kotlinVersion": "1.9.25"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "30c9f64d-25e2-4c6e-95af-38f9b99a735b"
      }
    }
  }
}
