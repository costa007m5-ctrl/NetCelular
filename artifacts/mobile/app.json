{
  "expo": {
    "name": "NETPLAY",
    "slug": "netplay",
    "owner": "netplaybr",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "netplay",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "primaryColor": "#e50914",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.netplay.app",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "Receba novidades e lançamentos do NETPLAY em primeira mão.",
        "UIBackgroundModes": ["audio", "fetch"]
      }
    },
    "android": {
      "package": "com.netplay.app",
      "versionCode": 4,
      "usesCleartextTraffic": true,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundImage": "./assets/images/icon_background.png"
      },
      "permissions": [
        "NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "navigationBar": {
        "backgroundColor": "#000000",
        "barStyle": "light-content"
      },
      "softwareKeyboardLayoutMode": "pan"
    },
    "notification": {
      "icon": "./assets/images/icon.png",
      "color": "#e50914",
      "iosDisplayInForeground": true,
      "androidMode": "default",
      "androidCollapsedTitle": "NETPLAY"
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "bundler": "metro",
      "name": "NETPLAY",
      "shortName": "NETPLAY",
      "description": "Descubra e assista aos melhores filmes e séries em streaming. Catálogo premium atualizado com os lançamentos mais recentes do cinema e TV.",
      "themeColor": "#e50914",
      "backgroundColor": "#000000",
      "lang": "pt-BR"
    },
    "updates": {
      "url": "https://u.expo.dev/aa86cc57-e8c0-4ce7-806c-0d1e5e345991",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "./plugins/withPictureInPicture",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#e50914",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      "expo-updates",
      [
        "expo-build-properties",
        {
          "android": {
            "buildConfig": true
          }
        }
      ],
      "./plugins/withBuildConfig"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "aa86cc57-e8c0-4ce7-806c-0d1e5e345991"
      },
      "apiDomain": "SEU-DOMINIO-AQUI.replit.app"
    }
  }
}
