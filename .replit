modules = ["nodejs-20", "web", "bash"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
run = ["bash", "-c", "API_PORT=8080 node artifacts/mobile/server/serve.js"]
build = ["bash", "-c", "npm install -g pnpm@10.26.1 --prefer-offline 2>/dev/null; export PATH=\"$PATH:$(npm root -g)/../bin\"; pnpm install --prefer-offline && pnpm --filter @workspace/api-server run build"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm install -g pnpm@10.26.1 --prefer-offline 2>/dev/null; export PATH=\"$PATH:$(npm root -g)/../bin\"; pnpm install --prefer-offline && ([ -f artifacts/api-server/dist/index.mjs ] || pnpm --filter @workspace/api-server run build) && API_PORT=8080 node artifacts/mobile/server/serve.js"
waitForPort = 5000

[agent]
stack = "BEST_EFFORT_FALLBACK"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3002

[[ports]]
localPort = 8083
externalPort = 4200

[[ports]]
localPort = 18115
externalPort = 3000

[[ports]]
localPort = 18116
externalPort = 3001

[nix]
channel = "stable-25_05"

